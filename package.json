{
  "name": "nails_app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/vitest.mjs run",
    "test:watch": "node scripts/vitest.mjs",
    "backfill:customers": "node --env-file=.env node_modules/ts-node/dist/bin.js --project tsconfig.scripts.json scripts/backfill-customers.ts",
    "db:backup": "node --env-file=.env node_modules/ts-node/dist/bin.js --project tsconfig.scripts.json scripts/backup-db.ts",
    "studios:migrate": "node --env-file=.env node_modules/ts-node/dist/bin.js --project tsconfig.scripts.json scripts/migrate-studios.ts",
    "users:create": "node --env-file=.env node_modules/ts-node/dist/bin.js --project tsconfig.scripts.json scripts/create-user.ts",
    "notes:convert": "node --env-file=.env node_modules/ts-node/dist/bin.js --project tsconfig.scripts.json scripts/convert-appointments-to-notes.ts"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "bcryptjs": "3.0.3",
    "date-fns": "4.1.0",
    "next": "16.4.6",
    "next-auth": "4.24.15",
    "qrcode": "1.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-qr-code": "2.0.18",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/node": "20.19.27",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "10.4.23",
    "eslint": "9.39.2",
    "eslint-config-next": "16.4.6",
    "postcss": "8.5.23",
    "prisma": "5.22.0",
    "tailwindcss": "3.4.17",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  }
}

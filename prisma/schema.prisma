generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
}

model Service {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  duration       Int
  price          Float
  description    String?
  category       String        @default("General")
  isActive       Boolean       @default(true)
  appointmentIDs String[]      @db.ObjectId
  appointments   Appointment[] @relation(fields: [appointmentIDs], references: [id])
}

// A client as an entity, identified by phone number. Before this model a client
// only existed denormalized on each Appointment (clientName + clientPhone) and
// "who is this person" was recomputed by grouping appointments on every search.
// The loyalty module needs something stable to attach stamps to.
//
// Appointments keep their own clientName/clientPhone copies: they are the record
// of what was agreed on that day and must not change when a client is renamed.
model Customer {
  id           String        @id @default(auto()) @map("_id") @db.ObjectId
  // Digits only, national format. See lib/phone.ts — every write goes through it.
  phone        String        @unique
  // Owner-controlled. Seeded from the first appointment and only ever changed
  // from the Clientas screen, so a later booking with a typo cannot undo an edit.
  name         String
  // Anything the studio needs to remember about her (allergies, preferences).
  notes        String?
  createdAt    DateTime      @default(now())
  // First time she activated her card on a phone. Doubles as the "enrolled"
  // flag and as the "miembro desde" line she reads on the card.
  joinedAt     DateTime?
  appointments Appointment[]
  stamps       Stamp[]
  redemptions  Redemption[]
  claimCodes   ClaimCode[]

  @@index([name])
}

// One-time code that binds a client's phone to her customer record.
//
// Enrollment only: stamps are granted by the owner at checkout and never by
// anything the client does. A stolen code buys nothing but the ability to see
// one person's stamp count on your own device.
model ClaimCode {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  // SHA-256 of the code. The plaintext exists in one HTTP response and nowhere
  // else — not in this row, not in a log. A database dump yields no live codes.
  codeHash   String    @unique
  customerId String    @db.ObjectId
  customer   Customer  @relation(fields: [customerId], references: [id])

  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdBy  String
  createdAt  DateTime  @default(now())

  @@index([customerId, consumedAt])
}

// Fixed-window request counter for the public claim endpoint, keyed by hashed
// IP. Rows outside the current window are pruned opportunistically on write, so
// the collection stays small without a TTL index Prisma cannot express.
model ClaimAttempt {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  ipHash      String
  windowStart DateTime
  count       Int      @default(0)

  @@unique([ipHash, windowStart])
  @@index([windowStart])
}

// Loyalty program settings. A single document, pinned by `key`, so the config
// can be edited without a deploy and every reward snapshot can point at it.
model RewardProgram {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  key             String   @unique @default("default")
  isActive        Boolean  @default(false)

  stampsRequired  Int      @default(5)

  // PERCENT_DISCOUNT | FIXED_AMOUNT | FREE_SERVICE
  rewardType      String   @default("PERCENT_DISCOUNT")
  rewardValue     Float    @default(50)
  // Caps what the reward can be worth. Without it, "50% off" on a $1,700 bridal
  // service costs far more than five express manicures brought in.
  maxRewardValue  Float?   @default(600)
  // What the client reads. Snapshotted into every Redemption.
  rewardLabel     String   @default("50% en tu próximo servicio")
  termsNote       String?

  updatedAt       DateTime @updatedAt
}

// The stamp ledger. A balance is never stored: it is the count of this
// collection's unspent rows, so it cannot drift away from its own history.
model Stamp {
  id            String      @id @default(auto()) @map("_id") @db.ObjectId
  customerId    String      @db.ObjectId
  customer      Customer    @relation(fields: [customerId], references: [id])

  // The anti-duplicate control: "appt:<appointmentId>" for an earned stamp,
  // "manual:<uuid>" for an owner adjustment. Always present and unique, so a
  // double grant fails at the database rather than racing in the application.
  //
  // It is a single composite key rather than a unique appointmentId because on
  // MongoDB a plain unique index treats an absent field as null, which would
  // permit exactly one manual stamp in the whole collection. Prisma's MongoDB
  // connector cannot express the partial index that would otherwise fix this.
  dedupeKey     String      @unique

  // APPOINTMENT | MANUAL
  source        String
  appointmentId String?     @db.ObjectId
  earnedAt      DateTime    @default(now())

  // Set when the stamp is spent. Always written explicitly, never left absent.
  redemptionId  String?     @db.ObjectId
  redemption    Redemption? @relation(fields: [redemptionId], references: [id])

  note          String?
  createdBy     String

  @@index([customerId, redemptionId])
}

// A reward that was handed over. Values are snapshotted so changing the program
// later never rewrites what a client was actually given.
model Redemption {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  customerId     String   @db.ObjectId
  customer       Customer @relation(fields: [customerId], references: [id])
  appointmentId  String?  @db.ObjectId

  // "appt:<appointmentId>" when applied at checkout, "manual:<uuid>" otherwise.
  // Same composite-key trick as Stamp.dedupeKey, and for the same reason: it
  // makes "one reward per appointment" a database guarantee, so a double tap on
  // Canjear cannot discount the same bill twice.
  dedupeKey      String   @unique

  stampsUsed     Int
  rewardLabel    String
  rewardType     String
  rewardValue    Float
  maxRewardValue Float?
  // Pesos actually discounted. Null until applied to an appointment.
  amountApplied  Float?

  stamps         Stamp[]
  redeemedAt     DateTime @default(now())
  createdBy      String

  @@index([customerId, redeemedAt])
}

model Appointment {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  createdAt      DateTime  @default(now())
  date           DateTime
  endDate        DateTime
  clientName     String
  // Opcional: una cita de mostrador o de menor de edad puede no tener teléfono.
  // Cuando es null, las funciones de WhatsApp se deshabilitan para esa cita.
  clientPhone    String?
  status         String    @default("CONFIRMED")

  // Pago
  paymentStatus  String    @default("PENDING")   // PENDING | PAID | PARTIAL
  paymentMethod  String?                          // CASH | CARD | TRANSFER
  depositPaid    Boolean   @default(false)
  depositAmount  Float?

  // Precio real (override del catálogo)
  finalPrice     Float?

  // Notas internas (solo ve el admin)
  adminNotes     String?

  // Distinguir si la creó el admin o vino de la web
  createdByAdmin Boolean   @default(false)

  // Null when the appointment has no usable phone (walk-ins, minors). Those
  // clients cannot be identified, so they have no customer record.
  customerId     String?   @db.ObjectId
  customer       Customer? @relation(fields: [customerId], references: [id])

  serviceIDs     String[]  @db.ObjectId
  services       Service[] @relation(fields: [serviceIDs], references: [id])

  @@index([customerId])
}

model WorkSchedule {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  dayOfWeek Int
  startTime String
  endTime   String
  isDayOff  Boolean  @default(false)
}

model BlockedDate {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  date      DateTime
  reason    String?
  createdAt DateTime @default(now())
}

// Registro de recordatorios enviados (bitácora). El mensaje/URL se genera en
// vivo desde los datos actuales de la cita, así nunca queda desfasado.
model Reminder {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  appointmentId String    @db.ObjectId
  clientName    String
  clientPhone   String
  scheduledFor  DateTime
  whatsappUrl   String?
  sent          Boolean   @default(false)
  sentAt        DateTime?
  createdAt     DateTime  @default(now())
}

model AvailabilityOverride {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  date      DateTime
  isClosed  Boolean  @default(false)
  startTime String?
  endTime   String?
  note      String?
  createdAt DateTime @default(now())
}
// Notas personales del panel: pendientes, compras, "tianguis", "fisio"...
//
// Antes se capturaban como citas gratis sin teléfono, lo que inflaba el conteo
// de citas y las métricas con cosas que no eran clientas. Una nota puede llevar
// fecha (aparece en el calendario) y, opcionalmente, apartar ese horario para
// que la web pública no ofrezca esos espacios. Solo la reserva pública lo
// respeta: desde el panel la dueña siempre puede agendar encima.
model Note {
  id             String     @id @default(auto()) @map("_id") @db.ObjectId
  title          String     @default("")
  body           String     @default("")
  // Checklist embebida: siempre se lee y escribe junto con la nota.
  items          NoteItem[]
  // Clave de NOTE_COLORS en lib/notes.ts, nunca una clase CSS cruda.
  color          String     @default("CREAM")
  pinned         Boolean    @default(false)
  archived       Boolean    @default(false)

  // Fecha opcional. Con allDay, startAt es la medianoche de Chihuahua de ese
  // día y endAt la del día siguiente; así el choque de horarios es un solo
  // cálculo de intervalos para ambos casos.
  startAt        DateTime?
  endAt          DateTime?
  allDay         Boolean    @default(false)
  blocksSchedule Boolean    @default(false)

  createdBy      String
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([archived, pinned, updatedAt])
  @@index([startAt])
}

type NoteItem {
  id   String
  text String
  done Boolean @default(false)
}

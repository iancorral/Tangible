# Copia este archivo a .env y llena los valores. Nunca subas .env al repo.

# MongoDB Atlas (Prisma). Ej.: mongodb+srv://user:pass@cluster/tangible
DATABASE_URL=

# NextAuth: secreto largo y aleatorio (openssl rand -base64 32) y la URL base.
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Firma del pase del celular en la tarjeta de sellos. Sin él no se activan
# tarjetas. Secreto aleatorio distinto de NEXTAUTH_SECRET.
REWARDS_PASS_SECRET=

# Sitio público (www): URL base, usada en QR, stickers NFC y enlaces de WhatsApp.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# WhatsApp del estudio a 10 dígitos o con lada (52...). Recibe las solicitudes de cita.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# --- Opcionales ---

# Nombre en los mensajes de WhatsApp (por defecto "Tangible Nails & Art Studio").
NEXT_PUBLIC_BUSINESS_NAME=

# Estudio que atiende el sitio público (por defecto "tangible").
PUBLIC_STUDIO_SLUG=

# Subdominio del panel, p. ej. admin.studiotangible.com.mx. Vacío: el panel
# vive en /admin. Ver docs/studios-y-subdominio.md.
ADMIN_HOST=

# Enlace para dejar reseña en Google (solo dominios de Google). Vacío: el de Tangible.
GOOGLE_REVIEW_URL=
